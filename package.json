{
  "name": "chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:migrate:local && npm run build && npm run preview",
    "build": "next build --webpack",
    "preview": "wrangler pages dev -c wrangler.jsonc -c worker/wrangler.jsonc --persist-to .wrangler/state",
    "start": "npm run preview",
    "lint": "eslint",
    "check:types": "next typegen && tsc --noEmit && tsc -p worker/tsconfig.json && tsc -p tests/tsconfig.json && tsc -p tests/ui/tsconfig.json",
    "test": "npm run test:worker && npm run test:ui",
    "test:worker": "vitest run",
    "test:ui": "vitest run --config vitest.ui.config.mts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config worker/wrangler.jsonc --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config worker/wrangler.jsonc",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy:pages": "wrangler pages deploy out --project-name gpt-harness --branch main",
    "deploy": "node scripts/deploy.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "streamdown": "^2.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  }
}
